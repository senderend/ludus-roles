# OpenClaw Hardened Configuration
# Generated by Ludus role
# Note: Most settings are also passed via environment variables in docker-compose

gateway:
  port: {{ openclaw_gateway_port }}
  bind: "{{ openclaw_gateway_bind }}"
  auth:
    enabled: true

mdns:
  enabled: {{ openclaw_mdns_enabled | string | lower }}

agents:
  defaults:
    sandbox:
      enabled: {{ openclaw_sandbox_enabled | string | lower }}
      scope: "{{ openclaw_sandbox_scope }}"
      docker:
        network: "{{ openclaw_sandbox_network }}"
        user: "{{ openclaw_uid }}:{{ openclaw_gid }}"

session:
  retention:
    maxAgeDays: {{ openclaw_session_max_age_days }}
  dmPolicy: "pairing"

browser:
{% if openclaw_browser_enabled %}
  mode: "gateway"
  proxyRouting: false
{% else %}
  mode: "off"
{% endif %}

hooks:
  enabled: {{ openclaw_hooks_enabled | string | lower }}
{% if openclaw_hooks_enabled %}
  requireAuth: true
{% endif %}

logging:
  level: "{{ openclaw_log_level }}"
  redactSecrets: true

skills:
  autoInstall: false
  requireApproval: true
