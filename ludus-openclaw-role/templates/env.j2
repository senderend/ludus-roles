# OpenClaw Environment Configuration
# WARNING: Contains secrets - protect this file

# Gateway authentication token (required)
OPENCLAW_GATEWAY_TOKEN={{ _openclaw_gateway_token }}

# Model provider API keys (configure at least one)
{% if openclaw_anthropic_api_key is defined and openclaw_anthropic_api_key != '' %}
ANTHROPIC_API_KEY={{ openclaw_anthropic_api_key }}
{% else %}
# ANTHROPIC_API_KEY=sk-ant-your-key-here
{% endif %}

{% if openclaw_openai_api_key is defined and openclaw_openai_api_key != '' %}
OPENAI_API_KEY={{ openclaw_openai_api_key }}
{% else %}
# OPENAI_API_KEY=sk-your-key-here
{% endif %}

{% if openclaw_openrouter_api_key is defined and openclaw_openrouter_api_key != '' %}
OPENROUTER_API_KEY={{ openclaw_openrouter_api_key }}
{% else %}
# OPENROUTER_API_KEY=your-key-here
{% endif %}

# Channel tokens (optional - configure as needed)
# SLACK_APP_TOKEN=xapp-your-token
# SLACK_BOT_TOKEN=xoxb-your-token
# DISCORD_TOKEN=your-discord-bot-token
# TELEGRAM_TOKEN=your-telegram-bot-token
