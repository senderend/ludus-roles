---
# OpenClaw Hardened Docker Compose
# Security-focused configuration for lab environments

services:
  openclaw-gateway:
    image: ghcr.io/openclaw/openclaw:latest
    container_name: openclaw-gateway
    restart: unless-stopped
    user: "{{ openclaw_uid }}:{{ openclaw_gid }}"
    
    # Security: Drop all capabilities, add only what's needed
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    
    # Security: No privilege escalation
    security_opt:
      - no-new-privileges:true
    
    environment:
      - NODE_ENV=production
      - OPENCLAW_GATEWAY_PORT={{ openclaw_gateway_port }}
      - OPENCLAW_GATEWAY_TOKEN=${OPENCLAW_GATEWAY_TOKEN}
      # Bind to all interfaces within container (firewall handles external access)
      - OPENCLAW_GATEWAY_BIND={{ openclaw_gateway_bind }}
      # Disable mDNS discovery (security: prevents network enumeration)
      - OPENCLAW_MDNS_ENABLED={{ openclaw_mdns_enabled | string | lower }}
{% if openclaw_sandbox_enabled %}
      # Enable Docker sandboxing for tool execution
      - OPENCLAW_SANDBOX_ENABLED=true
      - OPENCLAW_SANDBOX_SCOPE={{ openclaw_sandbox_scope }}
{% endif %}
      # Model provider keys (set in .env)
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
    
    ports:
      # Bind to host IP only (not 0.0.0.0)
      - "{{ ansible_default_ipv4.address }}:{{ openclaw_gateway_port }}:{{ openclaw_gateway_port }}"
    
    volumes:
      - /home/openclaw/.openclaw/config:/home/node/.openclaw/config:ro
      - /home/openclaw/.openclaw/workspace:/home/node/.openclaw/workspace:rw
      - /home/openclaw/.openclaw/agents:/home/node/.openclaw/agents:rw
{% if openclaw_sandbox_enabled %}
      # Mount Docker socket for sandboxing (controlled)
      - /var/run/docker.sock:/var/run/docker.sock
{% endif %}
    
    # Health check using node since curl may not be available
    healthcheck:
      test: ["CMD-SHELL", "node -e \"require('http').get('http://localhost:{{ openclaw_gateway_port }}/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '{{ openclaw_cpu_limit }}'
          memory: '{{ openclaw_memory_limit }}'
        reservations:
          cpus: '0.5'
          memory: 512M
    
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    
    networks:
      - openclaw-net

{% if openclaw_browser_enabled %}
  openclaw-browser:
    image: ghcr.io/openclaw/openclaw-browser:latest
    container_name: openclaw-browser
    restart: unless-stopped
    user: "{{ openclaw_uid }}:{{ openclaw_gid }}"
    
    cap_drop:
      - ALL
    cap_add:
      - SYS_ADMIN  # Required for Chrome sandbox
    security_opt:
      - no-new-privileges:true
      - seccomp:unconfined  # Required for Chrome sandbox
    
    environment:
      - DISPLAY=:99
      - OPENCLAW_BROWSER_HEADLESS=true
    
    # No external port exposure - gateway proxies
    expose:
      - "9222"
    
    volumes:
      - /home/openclaw/.openclaw/workspace:/workspace:rw
    
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 2G
    
    networks:
      - openclaw-net
    
    depends_on:
      openclaw-gateway:
        condition: service_healthy
{% endif %}

networks:
  openclaw-net:
    driver: bridge
    driver_opts:
      com.docker.network.bridge.enable_icc: "{{ openclaw_container_icc | string | lower }}"
